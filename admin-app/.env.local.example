# Vercel KV Environment Variables
KV_URL="redis://default:token@host:port"
KV_REST_API_URL="https://host.upstash.io"
KV_REST_API_TOKEN="your-rest-api-token"
KV_REST_API_READ_ONLY_TOKEN="your-read-only-token"

# Gemini API Key (server-side only — never expose to the client)
# Used for persona/speech generation prompt. Will also drive portrait image
# generation and TTS audio synthesis.
GEMINI_API_KEY="your-gemini-api-key"

# fal.ai API Key (server-side only — not used for video generation after HeyGen migration)
# May still be referenced by other tooling; leave it here for safety.
FAL_KEY="your-fal-api-key"

# HeyGen API key, pay-as-you-go, used for all avatar lip-sync video generation.
# Both snippet previews (720p) and full-length exports (720p/1080p/4k) use this key.
# Get one at https://app.heygen.com/settings/api
HEYGEN_API_KEY="your-heygen-api-key"
