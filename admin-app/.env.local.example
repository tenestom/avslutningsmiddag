# Vercel KV Environment Variables
KV_URL="redis://default:token@host:port"
KV_REST_API_URL="https://host.upstash.io"
KV_REST_API_TOKEN="your-rest-api-token"
KV_REST_API_READ_ONLY_TOKEN="your-read-only-token"

# Gemini API Key (server-side only — never expose to the client)
# Used for persona/speech generation prompt. Will also drive portrait image
# generation and TTS audio synthesis.
GEMINI_API_KEY="your-gemini-api-key"

# fal.ai API Key (server-side only — never expose to the client)
# Used for lip-sync video generation via the LTX-2 model.
# Pay-as-you-go, no subscription required. Get one at https://fal.ai/
FAL_KEY="your-fal-api-key"
